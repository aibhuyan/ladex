{
  "name": "ladex",
  "displayName": "Ladex — a bill of lading for AI",
  "description": "Inline AI governance: detects AI components as you type and flags what they obligate.",
  "version": "0.1.0",
  "publisher": "ladex",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0f766e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aibhuyan/ladex"
  },
  "bugs": {
    "url": "https://github.com/aibhuyan/ladex/issues"
  },
  "homepage": "https://github.com/aibhuyan/ladex#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai",
    "governance",
    "eu ai act",
    "aibom",
    "cyclonedx"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Ladex",
      "properties": {
        "ladex.serverCommand": {
          "type": "string",
          "default": "ladex",
          "description": "Command that launches the Ladex engine (must support `serve`)."
        },
        "ladex.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "serve"
          ],
          "description": "Arguments passed to the server command."
        },
        "ladex.attester": {
          "type": "string",
          "default": "",
          "description": "Name/email recorded as the attester for the 'attest' quick-fix. Empty prompts each time."
        },
        "ladex.diagnostics": {
          "type": "string",
          "enum": [
            "actionable",
            "all",
            "off"
          ],
          "enumDescriptions": [
            "Only flag AI that needs a human decision (a loadable model with unattested provenance/consent). Ordinary AI imports and calls stay silent.",
            "Also surface the full AI inventory, shown as faint hints so the actionable items still stand out.",
            "Disable Ladex diagnostics entirely."
          ],
          "default": "actionable",
          "description": "How much Ladex underlines in the editor. 'actionable' keeps it quiet and only speaks up where you must sign something."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run check-types && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
